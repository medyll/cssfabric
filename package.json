{
	"name": "@medyll/cssfabric",
	"scope": "@medyll",
	"version": "0.2.1-beta.8",
	"description": "fabric some css. Get pure and simple utility classes. Use the cssf file extension to go semantic. Get a preprocessor for cssf files. Generate your color scheme. Get your own css-properties.",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && npm run package",
		"preview": "vite preview",
		"package": "svelte-kit sync && svelte-package && publint",
		"prepublishOnly": "npm run package",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"prepare": "husky install",
		"commit": "node scripts/commit.js",
		"release": "standard-version",
		"release:alpha": "standard-version --prerelease alpha",
		"release:beta": "standard-version --prerelease beta",
		"release:minor": "standard-version --release-as minor"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"devDependencies": {
		"@sveltejs/adapter-auto": "^6.0.0",
		"@sveltejs/kit": "^2.20.3",
		"@sveltejs/package": "^2.3.10",
		"@sveltejs/vite-plugin-svelte": "^5.0.3",
		"@types/eslint": "9.6.1",
		"@types/fs-extra": "^11.0.4",
		"@typescript-eslint/eslint-plugin": "^8.29.0",
		"@typescript-eslint/parser": "^8.29.0",
		"eslint": "^9.23.0",
		"eslint-config-prettier": "^10.1.1",
		"eslint-plugin-svelte": "^3.5.0",
		"fs-extra": "^11.3.0",
		"glob": "^11.0.1",
		"husky": "^9.1.7",
		"json2md": "^2.0.2",
		"postcss": "^8.5.3",
		"prettier": "^3.5.3",
		"prettier-plugin-svelte": "^3.3.3",
		"publint": "^0.3.10",
		"simpler-color": "^1.0.2",
		"standard-version": "^9.5.0",
		"svelte": "^5.25.6",
		"svelte-check": "^4.1.5",
		"ts-node": "^10.9.2",
		"tslib": "^2.8.1",
		"typescript": "^5.8.2",
		"vite": "^6.2.5",
		"vitest": "^3.1.1"
	},
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"dependencies": {
		"inquirer": "^12.5.0",
		"svelte-highlight": "^7.8.3"
	}
}
